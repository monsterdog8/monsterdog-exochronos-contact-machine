    {"subject": "agent-alpha", "action": "email.send", "resource": "outbox/digest"},
    {"subject": "agent-beta", "action": "report.read", "resource": "reports/public/*"}
  ],
  "max_ttl_seconds": 300,
  "max_issued_at_skew_seconds": 60
}
